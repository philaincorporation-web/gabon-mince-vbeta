# Copier ce fichier en .env (jamais versionné) puis renseigner les valeurs.

# --- E-mails (formulaires) ---
GMAIL_USER=philaincorporation@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
SITE_URL=https://gabon-mince-vbeta.vercel.app/
CHATBASE_API_KEY=votre_clé_chatbase_ici

# --- Neon (récupérées automatiquement dans .env.local par `neon env pull`) ---
# Postgres : URL poolée pour l'application, URL directe pour les migrations
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Object Storage (bucket « assets »)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1

# --- Authentification (Better Auth) ---
# Secret aléatoire d'au moins 32 caractères : `npx @better-auth/cli secret` ou `openssl rand -base64 32`
AUTH_SECRET=
# URL publique du site (sans / final). En local : http://localhost:8080
AUTH_URL=https://gabon-mince-vbeta.vercel.app

# Connexion Google (Google Cloud Console > Identifiants > ID client OAuth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Administrateur initial (utilisé par `npm run db:seed`) ---
# Renseigner les identifiants communiqués en privé ; ne jamais les écrire dans un fichier versionné.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optionnel : e-mail de l'admin (défaut : <ADMIN_USERNAME>@gabonmice.local)
ADMIN_EMAIL=
# Optionnel : 1 = réinitialiser le mot de passe admin au prochain seed
ADMIN_RESET_PASSWORD=
